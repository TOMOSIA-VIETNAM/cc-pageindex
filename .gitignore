# Built by install.sh / install.ps1, never edited by hand
.venv/

__pycache__/
*.py[cod]

# Pages written by `pi.py html` (named `<name>.view.html`, as SKILL.md says): generated
# from a store, and they carry the indexed documents' summaries and structure.
# Regenerate rather than commit.
*.view.html

# A store placed inside the repository. The default lives in the platform's
# per-user data directory; this catches an override pointed here by mistake,
# which would commit whole documents.
/pageindex-store/
.pageindex/

.DS_Store
